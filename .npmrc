# Prisma 7's CLI (prisma migrate deploy, prisma db seed, ...) requires
# `@prisma/config` at runtime, which transitively depends on `effect`,
# `c12`, `deepmerge-ts`, `empathic`, and their own dep graphs. pnpm's
# default isolated store puts these under node_modules/.pnpm/ where only
# the pnpm-generated bin shim can find them (via NODE_PATH). In Docker
# the runner stage calls `npx prisma ...` directly, so we promote the
# whole graph to the flat node_modules/ tree.
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=effect
public-hoist-pattern[]=c12
public-hoist-pattern[]=deepmerge-ts
public-hoist-pattern[]=empathic
public-hoist-pattern[]=exsolve
public-hoist-pattern[]=@standard-schema/*
public-hoist-pattern[]=fast-check
public-hoist-pattern[]=pure-rand
public-hoist-pattern[]=pathe
public-hoist-pattern[]=defu
public-hoist-pattern[]=ohash
public-hoist-pattern[]=pkg-types
public-hoist-pattern[]=confbox
public-hoist-pattern[]=rc9
public-hoist-pattern[]=giget
public-hoist-pattern[]=chokidar
public-hoist-pattern[]=jiti
public-hoist-pattern[]=perfect-debounce
public-hoist-pattern[]=deepmerge

# Keep the default eslint/prettier hoists as well
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
