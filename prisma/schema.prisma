// =============================================================================
// Property Desk internal team & SaaS marketing pipeline
// =============================================================================
// This is the platform-level operational team that markets and sells the
// PropertyDesk SaaS itself (Setter, Closer, Operations, Manager). It is
// intentionally decoupled from tenant `Member.role` and from `User.role =
// SUPER_ADMIN`. A user can have any combination of those layers; SUPER_ADMIN
// always bypasses Property Desk team checks.

enum PropertyDeskTeamRole {
  SETTER
  CLOSER
  OPERATIONS
  MANAGER
}

enum PropertyDeskLeadScope {
  OWN
  OWN_AND_UNASSIGNED
  TEAM
  ALL
}

enum MarketingLeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  WON
  LOST
  NURTURING
}

/// Pipeline level (Sloj C, Property Desk). Nadgrupa stage-a — svaki
/// stage pripada tačno jednom levelu, a level određuje ko lead vidi:
/// SETTER radi SOURCING, CLOSER radi CLOSING, OPERATIONS radi handover
/// na WON, MANAGER/SUPER_ADMIN vide sve (uključujući ARCHIVED = LOST).
enum MarketingLeadLevel {
  SOURCING
  CLOSING
  OPERATIONS
  ARCHIVED
}

/// Prioritet lead-a u pipeline-u. Postavlja Setter/Closer/Manager
/// ručno; koristi se za sortiranje liste + „hot“ dashboard widget.
enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// „Temperatura“ interesa lead-a: koliko je zainteresovan/odlučan.
/// Ulazi u lead-score izračun.
enum LeadTemperature {
  COLD
  WARM
  HOT
}

/// Segment budžeta / plana za koji se lead interesuje. UNKNOWN dok se
/// ne kvalifikuje.
enum LeadBudgetTier {
  STARTER
  GROWTH
  ENTERPRISE
  UNKNOWN
}

/// Kada lead planira da počne. Ulazi u lead-score i u dashboard
/// „Follow-up 7 dana“ vidžet.
enum LeadTimeline {
  WITHIN_30D
  WITHIN_90D
  LATER
  UNDECIDED
}

/// Preferirani kanal kontakta koji je lead sam odabrao / preferira.
enum LeadContactChannel {
  PHONE
  EMAIL
  WHATSAPP
  VIBER
  OTHER
}

enum MarketingLeadAudience {
  INVESTOR
  AGENCY
  OTHER
}

/// Vrste redova u timeline-u marketing lead-a. `SYSTEM` redovi se automatski
/// upisuju (stage change, assignment, conversion, landing form) — ostali
/// redovi su ručno uneseni od strane članova Property Desk tima.
enum MarketingLeadActivityKind {
  CALL
  EMAIL
  MEETING
  NOTE
  STAGE_CHANGE
  ASSIGNMENT
  CONVERSION
  SYSTEM
}

// =============================================================================
// Tenant profile & subscriptions
// =============================================================================

model OrganizationProfile {
  id                    String             @id @default(cuid())
  organizationId        String             @unique
  type                  OrganizationType
  legalName             String
  displayName           String
  registrationNumber    String?
  taxNumber             String?
  address               String?
  city                  String?
  postalCode            String?
  country               String?            @default("RS")
  phone                 String?
  email                 String?
  website               String?
  logoUrl               String?
  // Faza 8.1 (A2). Serbian domestic 18-digit bank account for the
  // investor's IPS QR receiver. When present + currency=RSD, the
  // public reservation flow renders a scannable QR; otherwise the
  // buyer gets a plain reference number only.
  paymentAccountNumber  String?
  paymentBankName       String?
  status                OrganizationStatus @default(TRIAL)
  // Tracks the /prvi-koraci onboarding wizard. `completedAt` is stamped
  // when the operator finishes the last step; `dismissedAt` is a soft
  // hide flag used while the operator would rather not see the
  // checklist yet. The service always recomputes step completion from
  // real data, so these two fields never disagree with the actual
  // state.
  onboardingCompletedAt DateTime?
  onboardingDismissedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([status])
  @@map("organization_profile")
}

model SaaSPlan {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  description          String?
  monthlyPrice         Decimal  @db.Decimal(14, 2)
  quarterlyPrice       Decimal? @db.Decimal(14, 2)
  semiAnnualPrice      Decimal? @db.Decimal(14, 2)
  annualPrice          Decimal? @db.Decimal(14, 2)
  onboardingFee        Decimal? @db.Decimal(14, 2)
  currency             String   @default("EUR")
  maxActiveProjects    Int?
  maxUnits             Int?
  maxMembers           Int?
  maxAgencyConnections Int?
  features             Json     @default("{}")
  active               Boolean  @default(true)
  publiclyAvailable    Boolean  @default(true)
  recommended          Boolean  @default(false)
  defaultTrialDays     Int?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions OrganizationSubscription[]
  invoices      Invoice[]

  @@map("saas_plan")
}

model OrganizationSubscription {
  id                 String               @id @default(cuid())
  organizationId     String               @unique
  planId             String
  status             SubscriptionStatus   @default(TRIAL)
  billingCycle       BillingCycle         @default(MONTHLY)
  paymentMethod      BillingPaymentMethod @default(BANK_TRANSFER)
  price              Decimal              @default(0) @db.Decimal(14, 2)
  currency           String               @default("EUR")
  customPrice        Boolean              @default(false)
  customInvoiceNote  String?
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  startsAt           DateTime             @default(now())
  endsAt             DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  gracePeriodEndsAt  DateTime?
  restrictedAt       DateTime?
  suspendedAt        DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean              @default(false)
  autoRenew          Boolean              @default(true)
  manuallyManaged    Boolean              @default(true)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SaaSPlan                @relation(fields: [planId], references: [id])
  invoices     Invoice[]
  payments     SubscriptionPayment[]
  extensions   SubscriptionExtension[]

  @@index([status])
  @@index([nextBillingDate])
  @@map("organization_subscription")
}

/// Immutable audit trail. Never updated or deleted through the app service layer.
model AuditLog {
  id                   String   @id @default(cuid())
  organizationId       String?
  actorUserId          String?
  impersonatedByUserId String?
  action               String
  entityType           String
  entityId             String?
  previousValues       Json?
  newValues            Json?
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  impersonatedBy User?         @relation("AuditImpersonator", fields: [impersonatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// =============================================================================
// Inventory: projects → buildings → entrances → floors → units
// =============================================================================

model Project {
  id                     String        @id @default(cuid())
  organizationId         String
  code                   String
  name                   String
  slug                   String
  description            String?
  address                String?
  city                   String?
  municipality           String?
  postalCode             String?
  latitude               Decimal?      @db.Decimal(10, 7)
  longitude              Decimal?      @db.Decimal(10, 7)
  projectStatus          ProjectStatus @default(DRAFT)
  salesStartDate         DateTime?
  constructionStartDate  DateTime?
  expectedCompletionDate DateTime?
  completedAt            DateTime?
  defaultCurrency        String        @default("EUR")
  defaultVatRate         Decimal?      @db.Decimal(5, 2)
  coverImageUrl          String?
  internalNotes          String?
  isActive               Boolean       @default(true)
  createdByUserId        String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  archivedAt             DateTime?

  // A5 — internal cost tracking. All nullable to preserve existing
  // rows. `computeProjectPnl` reads these + `SUM(Sale.finalPrice)` to
  // produce the marža panel on /izvestaji/prodaje.
  landCost         Decimal? @db.Decimal(14, 2)
  constructionCost Decimal? @db.Decimal(14, 2)
  marketingCost    Decimal? @db.Decimal(14, 2)
  otherCost        Decimal? @db.Decimal(14, 2)
  budgetNote       String?

  // C1 — opt-in public microsite. Slug is optional; the resolver
  // falls back to the project's own `slug` when NULL.
  publicMicrositeEnabled Boolean @default(false)
  publicMicrositeSlug    String? @unique

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  buildings             Building[]
  units                 Unit[]
  buyerInterests        BuyerInterest[]
  activities            Activity[]
  tasks                 Task[]
  reservations          Reservation[]
  sales                 Sale[]
  agencyProjectAccess   AgencyProjectAccess[]
  agencyRegistrations   AgencyBuyerRegistration[]
  agencyCommissionRules AgencyCommissionRule[]
  paymentPlanTemplates  PaymentPlanTemplate[]

  @@unique([organizationId, code])
  @@unique([organizationId, slug])
  @@index([organizationId, projectStatus])
  @@index([organizationId, isActive])
  @@map("project")
}

model Building {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entrances Entrance[]
  units     Unit[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
  @@map("building")
}

model Entrance {
  id         String   @id @default(cuid())
  buildingId String
  code       String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floors   Floor[]
  units    Unit[]

  @@unique([buildingId, code])
  @@index([buildingId, sortOrder])
  @@map("entrance")
}

model Floor {
  id           String   @id @default(cuid())
  entranceId   String
  number       Int?
  label        String
  sortOrder    Int      @default(0)
  floorPlanUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entrance Entrance        @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  units    Unit[]
  areas    FloorPlanArea[]

  @@unique([entranceId, label])
  @@index([entranceId, sortOrder])
  @@map("floor")
}

/// Vector polygon overlaid on top of a floor's raster plan image.
/// Coordinates are stored as an array of `{ x, y }` pairs in the [0,1]
/// range (fractional coordinates), so the same polygon renders correctly
/// at any image scale. `unitId` is the anchor: clicking the polygon
/// navigates to that unit and colours it according to the unit's
/// current status.
model FloorPlanArea {
  id             String   @id @default(cuid())
  organizationId String
  floorId        String
  unitId         String
  /// JSON array of `{ x: number, y: number }`, both in [0, 1].
  polygon        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floor        Floor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId, floorId])
  @@index([unitId])
  @@map("floor_plan_area")
}

model Unit {
  id                  String     @id @default(cuid())
  organizationId      String
  projectId           String
  buildingId          String?
  entranceId          String?
  floorId             String?
  code                String
  externalReference   String?
  type                UnitType
  status              UnitStatus @default(AVAILABLE)
  structure           String?
  roomCount           Decimal?   @db.Decimal(4, 1)
  totalArea           Decimal    @db.Decimal(10, 2)
  internalArea        Decimal?   @db.Decimal(10, 2)
  terraceArea         Decimal?   @db.Decimal(10, 2)
  gardenArea          Decimal?   @db.Decimal(10, 2)
  orientation         String?
  basePrice           Decimal    @db.Decimal(14, 2)
  finalPrice          Decimal?   @db.Decimal(14, 2)
  pricePerSquareMeter Decimal?   @db.Decimal(14, 2)
  currency            String     @default("EUR")
  vatRate             Decimal?   @db.Decimal(5, 2)
  vatIncluded         Boolean    @default(false)
  bedrooms            Int?
  bathrooms           Int?
  hasTerrace          Boolean    @default(false)
  hasGarden           Boolean    @default(false)
  floorPlanUrl        String?
  publicDescription   String?
  internalNotes       String?
  isVisibleToAgencies Boolean    @default(false)
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  archivedAt          DateTime?
  version             Int        @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  building     Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  entrance     Entrance?    @relation(fields: [entranceId], references: [id], onDelete: SetNull)
  floor        Floor?       @relation(fields: [floorId], references: [id], onDelete: SetNull)

  priceHistory        UnitPriceHistory[]
  statusHistory       UnitStatusHistory[]
  reservations        Reservation[]
  reservationRequests ReservationRequest[]
  sales               Sale[]
  buyerInterests      BuyerInterest[]
  floorPlanAreas      FloorPlanArea[]

  @@unique([projectId, code])
  @@index([organizationId, status])
  @@index([organizationId, projectId, status])
  @@index([projectId, buildingId])
  @@index([projectId, type])
  @@index([organizationId, isVisibleToAgencies])
  @@map("unit")
}

model UnitPriceHistory {
  id                 String   @id @default(cuid())
  organizationId     String
  unitId             String
  previousBasePrice  Decimal  @db.Decimal(14, 2)
  newBasePrice       Decimal  @db.Decimal(14, 2)
  previousFinalPrice Decimal? @db.Decimal(14, 2)
  newFinalPrice      Decimal? @db.Decimal(14, 2)
  currency           String
  reason             String?
  changedByUserId    String
  changedAt          DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedByUser User         @relation("UnitPriceChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([unitId, changedAt])
  @@index([organizationId, changedAt])
  @@map("unit_price_history")
}

model UnitStatusHistory {
  id              String     @id @default(cuid())
  organizationId  String
  unitId          String
  previousStatus  UnitStatus
  newStatus       UnitStatus
  reason          String?
  changedByUserId String
  changedAt       DateTime   @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changedByUser User         @relation("UnitStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([unitId, changedAt])
  @@index([organizationId, changedAt])
  @@map("unit_status_history")
}

// =============================================================================
// CRM: buyers, interests, activities, tasks
// =============================================================================

model Buyer {
  id                     String        @id @default(cuid())
  organizationId         String
  firstName              String
  lastName               String
  email                  String?
  normalizedEmail        String?
  phone                  String
  normalizedPhone        String
  secondaryPhone         String?
  preferredContactMethod ContactMethod @default(ANY)
  budgetMin              Decimal?      @db.Decimal(14, 2)
  budgetMax              Decimal?      @db.Decimal(14, 2)
  preferredCurrency      String        @default("EUR")
  desiredUnitTypes       UnitType[]    @default([])
  desiredRoomCounts      String[]      @default([])
  desiredAreaMin         Decimal?      @db.Decimal(10, 2)
  desiredAreaMax         Decimal?      @db.Decimal(10, 2)
  notes                  String?
  source                 String?
  status                 BuyerStatus   @default(NEW)
  assignedUserId         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  archivedAt             DateTime?

  // B1 — KYC / legal-entity support. `entityType=LEGAL` unlocks
  // `legalName` + `taxId` (PIB); NATURAL uses `jmbg` /
  // `identityNumber`. Address fields feed A1 contract placeholders.
  jmbg           String?
  identityNumber String?
  taxId          String?
  entityType     BuyerEntityType @default(NATURAL)
  legalName      String?
  addressLine1   String?
  city           String?
  postalCode     String?
  country        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("BuyerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  kycChecklist        BuyerKycChecklist?
  interests           BuyerInterest[]
  activities          Activity[]
  tasks               Task[]
  reservations        Reservation[]
  sales               Sale[]
  agencyRegistrations AgencyBuyerRegistration[]

  @@index([organizationId, status])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, assignedUserId])
  @@map("buyer")
}

/// Faza 8.2 (B1). One row per `Buyer`. Toggling flags is an operator
/// action; `reviewedAt` timestamps every save.
model BuyerKycChecklist {
  id               String    @id @default(cuid())
  buyerId          String    @unique
  idFrontOk        Boolean   @default(false)
  idBackOk         Boolean   @default(false)
  addressProofOk   Boolean   @default(false)
  taxCertOk        Boolean   @default(false)
  reviewedByUserId String?
  reviewedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  buyer          Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reviewedByUser User? @relation("BuyerKycReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@map("buyer_kyc_checklist")
}

model BuyerInterest {
  id        String   @id @default(cuid())
  buyerId   String
  projectId String?
  unitId    String?
  note      String?
  createdAt DateTime @default(now())

  buyer   Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unit    Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([buyerId])
  @@map("buyer_interest")
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  buyerId        String?
  projectId      String?
  unitId         String?
  actorUserId    String
  type           ActivityType
  description    String
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyer        Buyer?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor        User         @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([buyerId, occurredAt])
  @@map("activity")
}

model Task {
  id              String       @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  assignedUserId  String
  buyerId         String?
  projectId       String?
  unitId          String?
  dueAt           DateTime
  priority        TaskPriority @default(NORMAL)
  status          TaskStatus   @default(OPEN)
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser  User         @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  buyer         Buyer?       @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser User         @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, dueAt])
  @@index([assignedUserId, status, dueAt])
  @@map("task")
}

// =============================================================================
// Reservations
// =============================================================================

model Reservation {
  id                   String            @id @default(cuid())
  organizationId       String
  projectId            String
  unitId               String
  buyerId              String
  createdByUserId      String
  assignedUserId       String?
  sourceType           ReservationSource @default(INTERNAL)
  agencyOrganizationId String?
  agencyAgentUserId    String?
  status               ReservationStatus @default(REQUESTED)
  requestedAt          DateTime          @default(now())
  approvedAt           DateTime?
  rejectedAt           DateTime?
  expiresAt            DateTime?
  canceledAt           DateTime?
  convertedAt          DateTime?
  reservationAmount    Decimal?          @db.Decimal(14, 2)
  currency             String            @default("EUR")
  notes                String?
  rejectionReason      String?
  cancellationReason   String?
  // C2 — attribution. When a reservation was converted from a public
  // `ReservationRequest` that carried a `?ref=<code>` parameter, this
  // column stores the same code. Used by /izvestaji/agencije to attribute
  // "Prihod preko referral-a" to the correct AgencyConnection.
  referralCode         String?
  version              Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buyer           Buyer        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  createdByUser   User         @relation("ReservationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedUser    User?        @relation("ReservationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  agencyAgentUser User?        @relation("ReservationAgencyAgent", fields: [agencyAgentUserId], references: [id], onDelete: SetNull)

  statusHistory ReservationStatusHistory[]
  sale          Sale?

  @@index([organizationId, status])
  @@index([unitId, status])
  @@index([expiresAt])
  @@map("reservation")
}

model ReservationStatusHistory {
  id              String            @id @default(cuid())
  organizationId  String
  reservationId   String
  previousStatus  ReservationStatus
  newStatus       ReservationStatus
  reason          String?
  changedByUserId String?
  changedAt       DateTime          @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation("ReservationStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([reservationId, changedAt])
  @@map("reservation_status_history")
}

// =============================================================================
// Agencies
// =============================================================================

model AgencyConnection {
  id                     String                 @id @default(cuid())
  investorOrganizationId String
  agencyOrganizationId   String
  status                 AgencyConnectionStatus @default(INVITED)
  invitedByUserId        String
  invitedAt              DateTime               @default(now())
  acceptedAt             DateTime?
  suspendedAt            DateTime?
  suspendedByUserId      String?
  notes                  String?
  defaultProtectionDays  Int                    @default(30)
  // C2 — referral. Auto-generated 8-char short id; UI exposes copy
  // link + QR PNG. `ReservationRequest.referralCode` mirrors this
  // value so the investor can attribute the sale on confirmation.
  referralCode           String?                @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  investor        Organization @relation("InvestorConnections", fields: [investorOrganizationId], references: [id], onDelete: Cascade)
  agency          Organization @relation("AgencyConnections", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  invitedByUser   User         @relation("AgencyConnectionInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  suspendedByUser User?        @relation("AgencyConnectionSuspender", fields: [suspendedByUserId], references: [id], onDelete: SetNull)

  projectAccess   AgencyProjectAccess[]
  commissionRules AgencyCommissionRule[]

  @@unique([investorOrganizationId, agencyOrganizationId])
  @@index([investorOrganizationId, status])
  @@index([agencyOrganizationId, status])
  @@map("agency_connection")
}

model AgencyProjectAccess {
  id                         String                    @id @default(cuid())
  agencyConnectionId         String
  projectId                  String
  status                     AgencyProjectAccessStatus @default(ACTIVE)
  accessStartsAt             DateTime?
  accessEndsAt               DateTime?
  canViewPrices              Boolean                   @default(true)
  canViewFloorPlans          Boolean                   @default(true)
  canRequestReservations     Boolean                   @default(true)
  showOnlyAgencyVisibleUnits Boolean                   @default(true)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  agencyConnection AgencyConnection @relation(fields: [agencyConnectionId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([agencyConnectionId, projectId])
  @@index([projectId, status])
  @@map("agency_project_access")
}

model AgencyUnitAccessOverride {
  id                 String   @id @default(cuid())
  agencyConnectionId String
  unitId             String
  visible            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([agencyConnectionId, unitId])
  @@map("agency_unit_access_override")
}

model AgencyBuyerRegistration {
  id                     String                        @id @default(cuid())
  investorOrganizationId String
  agencyOrganizationId   String
  agencyAgentUserId      String
  projectId              String
  buyerId                String
  status                 AgencyBuyerRegistrationStatus @default(PENDING)
  registeredAt           DateTime                      @default(now())
  protectionStartsAt     DateTime?
  protectionEndsAt       DateTime?
  reviewedByUserId       String?
  reviewedAt             DateTime?
  rejectionReason        String?
  conflictNotes          String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  investor       Organization @relation("InvestorAgencyRegistrations", fields: [investorOrganizationId], references: [id], onDelete: Cascade)
  agency         Organization @relation("AgencyAgencyRegistrations", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  agencyAgent    User         @relation("AgencyRegistrationAgent", fields: [agencyAgentUserId], references: [id], onDelete: Restrict)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buyer          Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reviewedByUser User?        @relation("AgencyRegistrationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([investorOrganizationId, status])
  @@index([agencyOrganizationId, status])
  @@index([projectId, buyerId, status])
  @@index([protectionEndsAt])
  @@map("agency_buyer_registration")
}

model AgencyCommissionRule {
  id                     String                    @id @default(cuid())
  investorOrganizationId String
  agencyConnectionId     String?
  projectId              String?
  unitId                 String?
  calculationType        CommissionCalculationType
  rate                   Decimal?                  @db.Decimal(6, 3)
  fixedAmount            Decimal?                  @db.Decimal(14, 2)
  currency               String                    @default("EUR")
  validFrom              DateTime?
  validTo                DateTime?
  internalNote           String?
  agencyVisibleNote      String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  investor         Organization      @relation(fields: [investorOrganizationId], references: [id], onDelete: Cascade)
  agencyConnection AgencyConnection? @relation(fields: [agencyConnectionId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id])

  @@index([investorOrganizationId, projectId])
  @@index([agencyConnectionId])
  @@index([unitId])
  @@map("agency_commission_rule")
}

// =============================================================================
// Sales, payment plans, payments, commissions, documents
// =============================================================================

model Sale {
  id                   String            @id @default(cuid())
  organizationId       String
  projectId            String
  unitId               String
  buyerId              String
  reservationId        String?           @unique
  sourceType           ReservationSource @default(INTERNAL)
  agencyOrganizationId String?
  agencyAgentUserId    String?
  responsibleUserId    String
  status               SaleStatus        @default(DRAFT)
  listPrice            Decimal           @db.Decimal(14, 2)
  discountType         SaleDiscountType?
  discountValue        Decimal?          @db.Decimal(14, 2)
  finalPrice           Decimal           @db.Decimal(14, 2)
  currency             String            @default("EUR")
  depositAmount        Decimal?          @db.Decimal(14, 2)
  preContractDate      DateTime?
  contractDate         DateTime?
  plannedHandoverDate  DateTime?
  actualHandoverDate   DateTime?
  notes                String?
  createdByUserId      String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  version              Int               @default(0)

  // A1 — contract generation. `contractTemplateId` is a soft FK: it
  // remains stable even if the underlying template is later deleted so
  // the "latest generated contract" audit trail stays queryable.
  contractStatus     SaleContractStatus @default(NONE)
  contractSentAt     DateTime?
  contractSignedAt   DateTime?
  contractTemplateId String?

  // B2 — tax treatment. All nullable so existing rows stay valid until
  // the operator explicitly sets them; `computeSaleTax` derives
  // `taxAmount` from `finalPrice` + `vatMode` when both are populated.
  vatMode   SaleVatMode?
  taxAmount Decimal?     @db.Decimal(14, 2)
  taxPayer  SaleTaxPayer @default(BUYER)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buyer           Buyer        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  reservation     Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  responsibleUser User         @relation("SaleResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdByUser   User         @relation("SaleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  agencyAgentUser User?        @relation("SaleAgencyAgent", fields: [agencyAgentUserId], references: [id], onDelete: SetNull)

  paymentPlan   PaymentPlan?
  payments      Payment[]
  commission    Commission?
  statusHistory SaleStatusHistory[]

  @@index([organizationId, status])
  @@index([unitId, status])
  @@index([projectId, status])
  @@map("sale")
}

model SaleStatusHistory {
  id              String     @id @default(cuid())
  organizationId  String
  saleId          String
  previousStatus  SaleStatus
  newStatus       SaleStatus
  reason          String?
  changedByUserId String?
  changedAt       DateTime   @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  changedByUser User?        @relation("SaleStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([saleId, changedAt])
  @@map("sale_status_history")
}

model PaymentPlan {
  id             String            @id @default(cuid())
  organizationId String
  saleId         String            @unique
  name           String
  totalAmount    Decimal           @db.Decimal(14, 2)
  currency       String            @default("EUR")
  status         PaymentPlanStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installments PaymentInstallment[]

  @@map("payment_plan")
}

model PaymentInstallment {
  id             String            @id @default(cuid())
  paymentPlanId  String
  sequenceNumber Int
  name           String
  amount         Decimal           @db.Decimal(14, 2)
  percentage     Decimal?          @db.Decimal(6, 3)
  dueDate        DateTime
  status         InstallmentStatus @default(UPCOMING)
  paidAmount     Decimal           @default(0) @db.Decimal(14, 2)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@unique([paymentPlanId, sequenceNumber])
  @@index([paymentPlanId, dueDate])
  @@index([status, dueDate])
  @@map("payment_installment")
}

/// Reusable installment blueprints owned by an investor Organization.
/// Two scopes are supported: (1) org-level default (`projectId = NULL`) and
/// (2) project-level override (`projectId = <project>`). At most one
/// template of each scope may be marked `isDefault = true`; the UI
/// enforces this via `PaymentPlanTemplatesService.setDefault`.
///
/// A template is a *blueprint* — applying it to a Sale materialises
/// concrete `PaymentInstallment` rows via `applyTemplateToDraft`. The
/// template itself is never mutated after apply, and PaymentPlan rows
/// keep no hard FK back to the template so template edits do not
/// silently alter historical plans.
model PaymentPlanTemplate {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  items PaymentPlanTemplateItem[]

  @@index([organizationId, projectId])
  @@map("payment_plan_template")
}

/// Faza 8.1 (A1) — reusable HTML blueprints for sale contracts and
/// pre-contracts. Content uses the same `{{var}}` placeholder syntax
/// as billing email templates (see `safeSubstitute`), so the same
/// safety rules apply: no arbitrary interpolation, HTML-escape by
/// default. `variables` is a manifest of expected keys used by the
/// admin UI to build a helper legend.
model SaleContractTemplate {
  id             String           @id @default(cuid())
  organizationId String
  kind           SaleContractKind
  name           String
  description    String?
  contentHtml    String
  variables      Json?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, isActive])
  @@map("sale_contract_template")
}

/// Single line of a `PaymentPlanTemplate`. Percentages must sum to
/// exactly 100 (with a 0.001% tolerance) when the template is saved.
model PaymentPlanTemplateItem {
  id             String        @id @default(cuid())
  templateId     String
  sequenceNumber Int
  label          String
  percentage     Decimal       @db.Decimal(6, 3)
  dueDateAnchor  DueDateAnchor @default(CONTRACT)
  offsetDays     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  template PaymentPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sequenceNumber])
  @@map("payment_plan_template_item")
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  saleId           String
  installmentId    String?
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @default("EUR")
  paymentDate      DateTime
  paymentMethod    PaymentMethod
  referenceNumber  String?
  note             String?
  proofDocumentId  String?
  createdByUserId  String
  createdAt        DateTime      @default(now())
  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  installment    PaymentInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  createdByUser  User                @relation("PaymentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedByUser User?               @relation("PaymentReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, paymentDate])
  @@index([saleId, paymentDate])
  @@map("payment")
}

/// Anonymous public-share tokens for unit offer pages (`/p/[token]`).
/// The token is a `crypto.randomBytes(24).toString("base64url")` value —
/// long enough that URL guessing is not feasible. Never reuse this row
/// after revocation; revoke = set `revokedAt`, then let the operator
/// create a new one if they need to keep sharing.
model ShareLink {
  id              String    @id @default(cuid())
  organizationId  String
  entityType      String
  entityId        String
  token           String    @unique
  createdByUserId String
  showPrice       Boolean   @default(true)
  expiresAt       DateTime?
  revokedAt       DateTime?
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser       User                 @relation("ShareLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reservationRequests ReservationRequest[]

  @@index([organizationId, entityType, entityId])
  @@map("share_link")
}

/// Faza 8.1 (A2). Public rezervacije-sa-kaparom flow: buyer submits a
/// PENDING row via /p/[token]; investor confirms → materialises a real
/// Reservation. `ipsReference` is the auto-generated `poziv na broj`
/// (P0/P1/T positions), and `ipsQrPngPath` is the storage key for the
/// pre-generated IPS QR image.
model ReservationRequest {
  id              String                   @id @default(cuid())
  organizationId  String
  shareLinkId     String?
  unitId          String
  firstName       String
  lastName        String
  email           String
  phone           String
  depositAmount   Decimal                  @db.Decimal(14, 2)
  currency        String                   @default("EUR")
  ipsReference    String
  ipsQrPngPath    String?
  status          ReservationRequestStatus @default(PENDING)
  expiresAt       DateTime
  referralCode    String?
  notes           String?
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shareLink     ShareLink?   @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  decidedByUser User?        @relation("ReservationRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([unitId, status])
  @@map("reservation_request")
}

/// Faza 8.3 (C4). Weekly automated self-checks. `BACKUP_VERIFY`
/// downloads the latest `pg_dump` and runs `pg_restore --list`;
/// `DB_MIGRATE_STATUS` is a placeholder for future checks.
model SystemHealthCheck {
  id      String                  @id @default(cuid())
  kind    SystemHealthCheckKind
  status  SystemHealthCheckStatus
  message String?
  runAt   DateTime                @default(now())

  @@index([kind, runAt])
  @@map("system_health_check")
}

/// Free-form threaded comment on a domain entity ("Buyer" or "Sale" today).
/// The server parses `@mentions` from `body` at write time and stores the
/// resulting user ids on `mentionedUserIds`; the parsed list is what
/// drives notifications. `parentId` supports one level of replies.
model Comment {
  id               String    @id @default(cuid())
  organizationId   String
  entityType       String
  entityId         String
  authorUserId     String
  body             String
  mentionedUserIds String[]  @default([])
  parentId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  parent       Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Comment[]    @relation("CommentReplies")

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("comment")
}

model Document {
  id               String             @id @default(cuid())
  organizationId   String
  category         DocumentCategory
  entityType       String
  entityId         String
  fileName         String
  originalFileName String
  mimeType         String
  size             Int
  storageKey       String
  uploadedByUserId String
  visibility       DocumentVisibility @default(INTERNAL)
  sortOrder        Int                @default(0)
  isCover          Boolean            @default(false)
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?
  /// Set by `purge-deleted-documents` after the object is removed from
  /// storage (45 days after `deletedAt`). Null means the file is still
  /// in the bucket / local dir.
  storagePurgedAt  DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedByUser User         @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, category])
  @@index([entityType, entityId])
  @@index([deletedAt, storagePurgedAt])
  @@map("document")
}

model Commission {
  id                     String                    @id @default(cuid())
  investorOrganizationId String
  agencyOrganizationId   String
  agencyAgentUserId      String?
  saleId                 String                    @unique
  commissionRuleId       String?
  calculationType        CommissionCalculationType
  rate                   Decimal?                  @db.Decimal(6, 3)
  fixedAmount            Decimal?                  @db.Decimal(14, 2)
  baseAmount             Decimal                   @db.Decimal(14, 2)
  calculatedAmount       Decimal                   @db.Decimal(14, 2)
  adjustedAmount         Decimal?                  @db.Decimal(14, 2)
  currency               String                    @default("EUR")
  status                 CommissionStatus          @default(CALCULATED)
  approvedAt             DateTime?
  invoicedAt             DateTime?
  dueDate                DateTime?
  paidAt                 DateTime?
  invoiceNumber          String?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  investor Organization @relation("CommissionInvestor", fields: [investorOrganizationId], references: [id], onDelete: Cascade)
  agency   Organization @relation("CommissionAgency", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  sale     Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([investorOrganizationId, status])
  @@index([agencyOrganizationId, status])
  @@map("commission")
}

// =============================================================================
// Notifications
// =============================================================================

model Notification {
  id             String               @id @default(cuid())
  organizationId String?
  userId         String
  category       NotificationCategory
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}

// =============================================================================
// Billing — SaaS invoicing, subscriptions, payments, automation
// =============================================================================

/// Singleton global billing settings. Enforced by unique partial index on
/// `active = true` — only one row can be active at a time. Old rows are kept
/// as history when settings change.
model GlobalBillingSettings {
  id     String  @id @default(cuid())
  active Boolean @default(true)

  billingEnabled              Boolean @default(true)
  autoGenerateInvoicesEnabled Boolean @default(true)
  autoSendInvoicesEnabled     Boolean @default(true)
  autoRemindersEnabled        Boolean @default(true)
  autoOverdueEnabled          Boolean @default(true)
  autoExtendSubscriptions     Boolean @default(true)
  autoRestrictAccessEnabled   Boolean @default(true)
  autoSuspendEnabled          Boolean @default(false)
  requireManualConfirmation   Boolean @default(false)

  defaultCurrency        String       @default("EUR")
  defaultInvoiceInRsd    Boolean      @default(false)
  defaultBillingCycle    BillingCycle @default(MONTHLY)
  defaultTrialDays       Int          @default(14)
  defaultGracePeriodDays Int          @default(7)
  defaultDueInDays       Int          @default(15)

  restrictedAfterDays Int @default(15)
  suspendedAfterDays  Int @default(45)

  invoiceNumberFormat String               @default("PD-{YYYY}-{SEQ:6}")
  invoiceNumberScope  BillingSequenceScope @default(GLOBAL_YEARLY)
  invoiceLocaleTag    String               @default("sr-Latn-RS")
  invoiceFooterNote   String?

  ipsQrEnabled              Boolean                       @default(true)
  electronicInvoiceEnabled  Boolean                       @default(false)
  electronicInvoiceProvider ElectronicInvoiceProviderType @default(MANUAL)

  reminderSchedule                 Json @default("[]")
  restrictedModeAllowedPermissions Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([active], map: "global_billing_settings_active_unique")
  @@map("global_billing_settings")
}

/// Per-organization billing overrides. In `USE_GLOBAL_SETTINGS` mode nothing
/// else on this row is used. In `CUSTOM_SETTINGS` mode, non-null overrides
/// apply. `BILLING_DISABLED` completely disables invoicing for this tenant.
model OrganizationBillingSettings {
  id             String              @id @default(cuid())
  organizationId String              @unique
  mode           BillingSettingsMode @default(USE_GLOBAL_SETTINGS)

  billingEnabled              Boolean?
  autoGenerateInvoicesEnabled Boolean?
  autoSendInvoicesEnabled     Boolean?
  autoRemindersEnabled        Boolean?
  autoOverdueEnabled          Boolean?
  autoExtendSubscriptions     Boolean?
  autoRestrictAccessEnabled   Boolean?
  autoSuspendEnabled          Boolean?

  gracePeriodDays     Int?
  dueInDays           Int?
  restrictedAfterDays Int?
  suspendedAfterDays  Int?
  reminderSchedule    Json?
  invoiceFooterNote   String?

  ipsQrEnabled              Boolean?
  electronicInvoiceEnabled  Boolean?
  electronicInvoiceProvider ElectronicInvoiceProviderType?

  invoiceInRsd Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_billing_settings")
}

/// Issuer identity for all invoices. Kept as a first-class table so that
/// history is preserved when values change: issued invoices retain their own
/// snapshot in `Invoice.issuerSnapshot`.
model CompanyBillingProfile {
  id                 String         @id @default(cuid())
  active             Boolean        @default(true)
  legalName          String
  tradeName          String?
  taxNumber          String
  registrationNumber String?
  vatId              String?
  vatRegistered      Boolean        @default(false)
  addressLine1       String
  addressLine2       String?
  city               String
  postalCode         String
  country            String         @default("RS")
  email              String?
  phone              String?
  website            String?
  logoStorageKey     String?
  sefEnvironment     SefEnvironment @default(DISABLED)
  sefApiKeyEncrypted String?
  sefEndpointUrl     String?
  invoiceNote        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([active], map: "company_billing_profile_active_unique")
  @@map("company_billing_profile")
}

model BillingBankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountNumber String
  iban          String?
  swiftBic      String?
  currency      String
  holderName    String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices Invoice[]

  @@index([currency, isActive])
  @@map("billing_bank_account")
}

model Invoice {
  id             String  @id @default(cuid())
  organizationId String
  subscriptionId String?
  planId         String?
  bankAccountId  String?

  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  source        InvoiceSource @default(AUTOMATIC)

  currency    String
  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)
  amountPaid  Decimal @default(0) @db.Decimal(14, 2)
  amountDue   Decimal @db.Decimal(14, 2)

  // FX snapshot: when an invoice is issued in RSD but priced in EUR, we
  // keep the pre-conversion "base" amounts and the applied middle rate so
  // the PDF can display both sides and auditors can reproduce the math.
  // `null` means no conversion happened (native-currency invoice).
  baseCurrency    String?
  baseSubtotal    Decimal?  @db.Decimal(14, 2)
  baseTaxAmount   Decimal?  @db.Decimal(14, 2)
  baseTotalAmount Decimal?  @db.Decimal(14, 2)
  fxRate          Decimal?  @db.Decimal(18, 6)
  fxRateDate      DateTime? @db.Date

  issueDate  DateTime?
  dueDate    DateTime?
  paidAt     DateTime?
  sentAt     DateTime?
  canceledAt DateTime?

  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?

  billingCycle BillingCycle?
  language     String        @default("sr-Latn-RS")
  note         String?
  internalNote String?
  ipsQrPayload String?

  issuerSnapshot      Json
  customerSnapshot    Json
  bankAccountSnapshot Json?

  pdfStorageKey   String?
  ipsQrStorageKey String?

  createdByUserId String?
  issuedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SaaSPlan?                 @relation(fields: [planId], references: [id])
  bankAccount  BillingBankAccount?       @relation(fields: [bankAccountId], references: [id])
  createdBy    User?                     @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  issuedBy     User?                     @relation("InvoiceIssuer", fields: [issuedByUserId], references: [id])

  items             InvoiceItem[]
  allocations       PaymentAllocation[]
  extensions        SubscriptionExtension[]
  electronicRecords ElectronicInvoiceRecord[]

  @@index([organizationId, status])
  @@index([status, dueDate])
  @@index([subscriptionId])
  @@map("invoice")
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  type        InvoiceItemType @default(SUBSCRIPTION)
  description String
  quantity    Decimal         @default(1) @db.Decimal(14, 4)
  unitPrice   Decimal         @db.Decimal(14, 2)
  taxRate     Decimal         @default(0) @db.Decimal(6, 3)
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  sortOrder   Int             @default(0)
  metadata    Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}

model SubscriptionPayment {
  id                         String                      @id @default(cuid())
  organizationId             String
  subscriptionId             String?
  provider                   SubscriptionPaymentProvider @default(MANUAL)
  status                     SubscriptionPaymentStatus   @default(COMPLETED)
  amount                     Decimal                     @db.Decimal(14, 2)
  currency                   String
  paidAt                     DateTime                    @default(now())
  providerTransactionId      String?
  bankStatementTransactionId String?
  reference                  String?
  note                       String?
  reversedAt                 DateTime?
  reversalReason             String?
  reversedByUserId           String?
  createdByUserId            String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  bankTransaction BankStatementTransaction? @relation(fields: [bankStatementTransactionId], references: [id], onDelete: SetNull)
  reversedByUser  User?                     @relation("SubscriptionPaymentReverser", fields: [reversedByUserId], references: [id])
  createdByUser   User?                     @relation("SubscriptionPaymentRecorder", fields: [createdByUserId], references: [id])

  allocations PaymentAllocation[]

  @@index([organizationId, status])
  @@index([bankStatementTransactionId])
  @@map("subscription_payment")
}

model PaymentAllocation {
  id                    String   @id @default(cuid())
  subscriptionPaymentId String
  invoiceId             String
  amount                Decimal  @db.Decimal(14, 2)
  currency              String
  createdAt             DateTime @default(now())

  subscriptionPayment SubscriptionPayment @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Cascade)
  invoice             Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPaymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

/// Idempotency record for automatic subscription extensions triggered by
/// invoice payment. The unique `(subscriptionId, invoiceId)` prevents double
/// extension when the payment job retries.
model SubscriptionExtension {
  id             String       @id @default(cuid())
  organizationId String
  subscriptionId String
  invoiceId      String
  extendedFrom   DateTime
  extendedTo     DateTime
  cycle          BillingCycle
  createdAt      DateTime     @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice                  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, invoiceId])
  @@index([organizationId])
  @@map("subscription_extension")
}

model BankStatementImport {
  id                String                    @id @default(cuid())
  organizationId    String?
  format            BankStatementFormat
  fileName          String
  storageKey        String
  status            BankStatementImportStatus @default(PENDING)
  totalTransactions Int                       @default(0)
  matchedCount      Int                       @default(0)
  unmatchedCount    Int                       @default(0)
  errorCount        Int                       @default(0)
  errorMessage      String?
  uploadedByUserId  String?
  processedAt       DateTime?
  createdAt         DateTime                  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy   User?         @relation("BankStatementImportUploader", fields: [uploadedByUserId], references: [id])

  transactions BankStatementTransaction[]

  @@index([status])
  @@map("bank_statement_import")
}

model BankStatementTransaction {
  id               String                     @id @default(cuid())
  importId         String
  organizationId   String?
  matchedInvoiceId String?
  transactionDate  DateTime
  valueDate        DateTime?
  amount           Decimal                    @db.Decimal(14, 2)
  currency         String
  counterpartyName String?
  counterpartyIban String?
  counterpartyRef  String?
  reference        String?
  narrative        String?
  externalId       String?
  matchStatus      BankTransactionMatchStatus @default(UNMATCHED)
  matchConfidence  Int                        @default(0)
  matchNotes       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  import       BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("BankStatementReviewer", fields: [reviewedByUserId], references: [id])

  payments SubscriptionPayment[]

  @@index([importId])
  @@index([matchStatus])
  @@index([organizationId])
  @@map("bank_statement_transaction")
}

model ElectronicInvoiceRecord {
  id                    String                        @id @default(cuid())
  organizationId        String
  invoiceId             String
  provider              ElectronicInvoiceProviderType
  status                ElectronicInvoiceStatus       @default(PENDING)
  providerReference     String?
  providerStatusCode    String?
  providerStatusMessage String?
  sentAt                DateTime?
  lastSyncAt            DateTime?
  attempts              Int                           @default(0)
  errorMessage          String?
  payload               Json?
  responsePayload       Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("electronic_invoice_record")
}

model BillingJobRun {
  id                String           @id @default(cuid())
  jobType           BillingJobType
  status            BillingJobStatus @default(RUNNING)
  triggeredBy       String
  triggeredByUserId String?
  processedCount    Int              @default(0)
  successCount      Int              @default(0)
  errorCount        Int              @default(0)
  skippedCount      Int              @default(0)
  startedAt         DateTime         @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  summary           Json?
  errorMessage      String?

  triggeredByUser User? @relation(fields: [triggeredByUserId], references: [id])

  @@index([jobType, startedAt])
  @@index([status])
  @@map("billing_job_run")
}

model BillingSequence {
  id             String               @id @default(cuid())
  organizationId String?
  scope          BillingSequenceScope
  year           Int
  month          Int?
  nextValue      Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scope, organizationId, year, month], map: "billing_sequence_scope_org_year_month_unique")
  @@map("billing_sequence")
}

model BillingEmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  subject     String
  bodyHtml    String
  bodyText    String
  locale      String   @default("sr-Latn-RS")
  variables   Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("billing_email_template")
}

/// Per-role permission overrides.
///
/// Roles ship with a code-defined default grant matrix (see
/// `src/server/permissions/roles.ts`). Rows in this table let a SUPER_ADMIN
/// grant or revoke individual `resource.action` pairs for any role
/// without a code change. A row is authoritative: `granted=true` allows
/// the action, `granted=false` denies it. Missing row → default applies.
///
/// The `role` string is either an OrganizationRole (e.g. `SALES_MANAGER`)
/// or the platform role `SUPER_ADMIN`. `permission` is the canonical
/// `resource.action` form (e.g. `project.create`, `billing.invoice.manage`).
model RolePermissionOverride {
  id              String   @id @default(cuid())
  role            String
  permission      String
  granted         Boolean
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@unique([role, permission])
  @@index([role])
  @@map("role_permission_override")
}

/// Property Desk internal team member — participation of a User in the
/// platform-level operational team that markets and sells the PropertyDesk
/// SaaS product itself. A user may exist in `user` without any Property Desk
/// team row; adding a row here means the user can access
/// `/administracija/property-desk/**`. This is orthogonal to `Member.role`
/// (tenant RBAC) and to `User.role = "SUPER_ADMIN"` (platform admin).
model PropertyDeskTeamMember {
  id              String                @id @default(cuid())
  userId          String                @unique
  teamRole        PropertyDeskTeamRole
  enabled         Boolean               @default(true)
  leadScope       PropertyDeskLeadScope @default(OWN_AND_UNASSIGNED)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdByUserId String?

  user      User  @relation("PropertyDeskTeamMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PropertyDeskTeamCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([teamRole])
  @@index([enabled])
  @@map("property_desk_team_member")
}

/// Persistent marketing lead — a person / company that expressed interest in
/// PropertyDesk (via the public landing form, ad, referral, etc.). This is
/// completely separate from tenant `Buyer` (real-estate CRM). The record
/// travels through a light-weight pipeline (`stage`) and can eventually be
/// converted into a tenant `Organization` once the deal is won.
model MarketingLead {
  id                       String                @id @default(cuid())
  email                    String                @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  audience                 MarketingLeadAudience @default(OTHER)
  city                     String?
  projectCount             Int?
  note                     String?
  source                   String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  utmTerm                  String?
  utmContent               String?
  consent                  Boolean               @default(false)
  stage                    MarketingLeadStage    @default(NEW)
  // Level je „nadgrupa“ stage-a i eksplicitno se čuva zbog vidljivosti
  // i indeksa. Uvek prati `stage` kroz `computeLevel(stage)` u
  // src/server/services/property-desk/lead-lifecycle.ts.
  level                    MarketingLeadLevel    @default(SOURCING)
  previousLevel            MarketingLeadLevel?
  levelEnteredAt           DateTime              @default(now())
  // Klasifikacija (setovana ručno ili preko landing forme).
  priority                 LeadPriority          @default(NORMAL)
  temperature              LeadTemperature       @default(COLD)
  timelineHorizon          LeadTimeline          @default(UNDECIDED)
  nextFollowUpAt           DateTime?
  // Deterministički lead-score 0–100 (see lead-scoring.ts).
  leadScore                Int                   @default(0)
  // Firma / organizacija za koju lead radi.
  companyName              String?
  companyWebsite           String?
  companySize              Int?
  // Novac.
  budgetTier               LeadBudgetTier        @default(UNKNOWN)
  budgetCurrency           String?               @default("EUR")
  // Donosilac odluke i preferirani kanal kontakta.
  decisionMakerName        String?
  decisionMakerTitle       String?
  preferredContact         LeadContactChannel?
  bestContactHour          String?
  preferredLanguage        String?               @default("sr")
  // Konkurencija / trenutno stanje kod klijenta.
  competitor               String?
  painPoint                String?
  // Geo.
  country                  String?               @default("RS")
  region                   String?
  assignedToUserId         String?
  convertedOrganizationId  String?
  convertedAt              DateTime?
  lostReason               String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  assignedTo             User?         @relation("MarketingLeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedOrganization  Organization? @relation("MarketingLeadConvertedTo", fields: [convertedOrganizationId], references: [id], onDelete: SetNull)
  activities             MarketingLeadActivity[]
  tasks                  MarketingLeadTask[]

  @@index([stage])
  @@index([level, priority])
  @@index([assignedToUserId])
  @@index([createdAt(sort: Desc)])
  @@index([audience])
  @@index([nextFollowUpAt])
  @@index([leadScore(sort: Desc)])
  @@map("marketing_lead")
}

/// Timeline entry for a marketing lead. `SYSTEM` rows are emitted from the
/// services (stage change, assignment, conversion, landing form arrival);
/// CALL/EMAIL/MEETING/NOTE are ručno uneseni od Property Desk tima.
/// Namerno je odvojen od tenant `Activity` modela: taj je organization-scoped,
/// dok je marketing timeline platformski (Sloj C).
model MarketingLeadActivity {
  id            String                    @id @default(cuid())
  leadId        String
  kind          MarketingLeadActivityKind
  title         String
  body          String?                   @db.Text
  actorUserId   String?
  occurredAt    DateTime                  @default(now())
  metadata      Json?
  createdAt     DateTime                  @default(now())

  lead    MarketingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor   User?         @relation("MarketingLeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([kind])
  @@index([actorUserId])
  @@map("marketing_lead_activity")
}

/// Follow-up task attached to a marketing lead. Odvojeno od tenant `Task`
/// modela jer je platformski i vezan za `MarketingLead`, ne za tenant
/// entitete. Overdue = `dueAt < now() AND completedAt IS NULL`.
model MarketingLeadTask {
  id                String    @id @default(cuid())
  leadId            String
  title             String
  description       String?   @db.Text
  dueAt             DateTime?
  completedAt       DateTime?
  assignedToUserId  String?
  createdByUserId   String
  completedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lead        MarketingLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo  User?         @relation("MarketingLeadTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("MarketingLeadTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy User?         @relation("MarketingLeadTaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedToUserId, completedAt])
  @@index([dueAt])
  @@map("marketing_lead_task")
}

/// Manually-maintained (with a stub for NBS automation) exchange-rate list.
/// A single row means "as of `effectiveDate`, 1 `baseCurrency` = `rate`
/// `quoteCurrency`". `issueInvoice` picks the newest row with
/// `effectiveDate <= issueDate` when converting an EUR invoice to RSD for
/// domestic clients. Rates are `Decimal(18,6)` — the extra precision is
/// necessary because we multiply large invoice amounts by the rate.
model ExchangeRate {
  id              String             @id @default(cuid())
  baseCurrency    String             @default("EUR")
  quoteCurrency   String             @default("RSD")
  rate            Decimal            @db.Decimal(18, 6)
  effectiveDate   DateTime           @db.Date
  source          ExchangeRateSource @default(MANUAL)
  note            String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([baseCurrency, quoteCurrency, effectiveDate])
  @@index([baseCurrency, quoteCurrency, effectiveDate])
  @@map("exchange_rate")
}
