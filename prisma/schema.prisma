/// investor UI and to power the "Ugovor" section on the sale detail page.
enum SaleContractStatus {
  NONE
  GENERATED
  SENT
  SIGNED
  CANCELED
}

/// Serbia-specific two-step sales process: a preliminary contract
/// (predugovor) usually locks the deposit + terms; the full contract
/// (ugovor o kupoprodaji) is signed at the notary once financing +
/// KYC are complete.
enum SaleContractKind {
  PRE_CONTRACT
  CONTRACT
}

/// Fiscal treatment of a sale. Faza 8.2 (`B2`): drives `computeSaleTax`
/// and A1's `{{tax.mode}}`/`{{tax.amount}}` contract placeholders.
///
/// Values mirror Serbian tax practice:
///   * NEW_BUILD_10          — 10% PDV on first-time new-build sale
///   * SECONDARY_MARKET_2_5  — 2.5% PPAP on secondary market
///   * NONE                  — no tax (rare, e.g. some agencies)
enum SaleVatMode {
  NEW_BUILD_10
  SECONDARY_MARKET_2_5
  NONE
}

