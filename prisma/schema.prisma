// PropertyDesk — Prisma schema (consolidated, single migration history)
// -----------------------------------------------------------------------------
// Portable to any standard PostgreSQL (Neon in dev, self-hosted on VPS later).
// The application uses `DATABASE_URL` (pooled), Prisma CLI uses `DIRECT_URL`
// (via prisma.config.ts).
//
// Conventions:
//   - `cuid()` for primary keys
//   - `Decimal(14,2)` for money, `Decimal(10,2)` for area
//   - every tenant-owned model carries an `organizationId` FK
//   - unique indexes enforce business rules (e.g. one active reservation per unit)
//   - audit rows are append-only (application layer never updates/deletes them)
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Better Auth — core tables (users, sessions, accounts, verification)
// =============================================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth `admin` plugin
  role       String? // platform-level role (e.g. "SUPER_ADMIN")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // App-side deactivation flag (tenant admins soft-disable members here
  // without touching the Better Auth ban mechanism).
  deactivatedAt DateTime?

  // Per-user UI language (`sr-Latn` | `en`). Independent of org / invoices.
  locale String @default("sr-Latn")

  accounts         Account[]
  sessions         Session[]
  memberships      Member[]
  invitationsSent  Invitation[] @relation("InvitationInviter")
  auditLogsAsActor AuditLog[]   @relation("AuditActor")
  auditLogsAsImp   AuditLog[]   @relation("AuditImpersonator")

  projectsCreated   Project[]           @relation("ProjectCreator")
  unitPriceChanges  UnitPriceHistory[]  @relation("UnitPriceChangedBy")
  unitStatusChanges UnitStatusHistory[] @relation("UnitStatusChangedBy")

  buyersAssigned      Buyer[]              @relation("BuyerAssignee")
  buyerKycReviews     BuyerKycChecklist[]  @relation("BuyerKycReviewer")
  reservationRequests ReservationRequest[] @relation("ReservationRequestDecider")
  activities          Activity[]           @relation("ActivityActor")
  tasksAssigned       Task[]               @relation("TaskAssignee")
  tasksCreated        Task[]               @relation("TaskCreator")

  reservationsCreated      Reservation[]              @relation("ReservationCreator")
  reservationsAssigned     Reservation[]              @relation("ReservationAssignee")
  reservationsAsAgent      Reservation[]              @relation("ReservationAgencyAgent")
  reservationStatusChanges ReservationStatusHistory[] @relation("ReservationStatusChangedBy")

  agencyConnectionsInvited    AgencyConnection[]        @relation("AgencyConnectionInviter")
  agencyConnectionsSuspended  AgencyConnection[]        @relation("AgencyConnectionSuspender")
  agencyRegistrationsAsAgent  AgencyBuyerRegistration[] @relation("AgencyRegistrationAgent")
  agencyRegistrationsReviewed AgencyBuyerRegistration[] @relation("AgencyRegistrationReviewer")

  salesResponsible   Sale[]              @relation("SaleResponsible")
  salesCreated       Sale[]              @relation("SaleCreator")
  salesAsAgencyAgent Sale[]              @relation("SaleAgencyAgent")
  saleStatusChanges  SaleStatusHistory[] @relation("SaleStatusChangedBy")

  paymentsCreated  Payment[] @relation("PaymentCreator")
  paymentsReversed Payment[] @relation("PaymentReverser")

  documentsUploaded Document[]  @relation("DocumentUploader")
  shareLinksCreated ShareLink[] @relation("ShareLinkCreator")

  commentsAuthored Comment[] @relation("CommentAuthor")

  notifications Notification[]

  invoicesCreated              Invoice[]                  @relation("InvoiceCreator")
  invoicesIssued               Invoice[]                  @relation("InvoiceIssuer")
  subscriptionPaymentsRecorded SubscriptionPayment[]      @relation("SubscriptionPaymentRecorder")
  subscriptionPaymentsReversed SubscriptionPayment[]      @relation("SubscriptionPaymentReverser")
  bankStatementImports         BankStatementImport[]      @relation("BankStatementImportUploader")
  bankStatementReviews         BankStatementTransaction[] @relation("BankStatementReviewer")
  billingJobRuns               BillingJobRun[]

  // Property Desk internal team (marketing / SaaS sales)
  propertyDeskTeam             PropertyDeskTeamMember?      @relation("PropertyDeskTeamMember")
  propertyDeskTeamCreated      PropertyDeskTeamMember[]     @relation("PropertyDeskTeamCreator")
  marketingLeadsAssigned       MarketingLead[]              @relation("MarketingLeadAssignee")
  marketingLeadActivities      MarketingLeadActivity[]      @relation("MarketingLeadActivityActor")
  marketingLeadTasksCreated    MarketingLeadTask[]          @relation("MarketingLeadTaskCreator")
  marketingLeadTasksAssigned   MarketingLeadTask[]          @relation("MarketingLeadTaskAssignee")
  marketingLeadTasksCompleted  MarketingLeadTask[]          @relation("MarketingLeadTaskCompleter")

  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth `admin` plugin — set while an admin is impersonating another user
  impersonatedBy String?

  // Better Auth `organization` plugin — the org the user is currently acting in
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =============================================================================
// Better Auth — organization plugin tables
// =============================================================================

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]

  profile      OrganizationProfile?
  subscription OrganizationSubscription?
  auditLogs    AuditLog[]

  projects                  Project[]
  units                     Unit[]
  unitPriceHistory          UnitPriceHistory[]
  unitStatusHistory         UnitStatusHistory[]
  buyers                    Buyer[]
  activities                Activity[]
  tasks                     Task[]
  reservations              Reservation[]
  reservationStatusHistory  ReservationStatusHistory[]
  agencyConnectionsAsInv    AgencyConnection[]         @relation("InvestorConnections")
  agencyConnectionsAsAgency AgencyConnection[]         @relation("AgencyConnections")
  agencyRegistrationsAsInv  AgencyBuyerRegistration[]  @relation("InvestorAgencyRegistrations")
  agencyRegistrationsAsAgy  AgencyBuyerRegistration[]  @relation("AgencyAgencyRegistrations")
  agencyCommissionRules     AgencyCommissionRule[]
  sales                     Sale[]
  saleStatusHistory         SaleStatusHistory[]
  paymentPlans              PaymentPlan[]
  paymentPlanTemplates      PaymentPlanTemplate[]
  saleContractTemplates     SaleContractTemplate[]
  reservationRequests       ReservationRequest[]
  payments                  Payment[]
  documents                 Document[]
  shareLinks                ShareLink[]
  comments                  Comment[]
  floorPlanAreas            FloorPlanArea[]
  commissionsAsInvestor     Commission[]               @relation("CommissionInvestor")
  commissionsAsAgency       Commission[]               @relation("CommissionAgency")
  notifications             Notification[]

  billingSettings           OrganizationBillingSettings?
  invoices                  Invoice[]
  subscriptionPayments      SubscriptionPayment[]
  subscriptionExtensions    SubscriptionExtension[]
  bankStatementImports      BankStatementImport[]
  bankStatementTransactions BankStatementTransaction[]
  electronicInvoiceRecords  ElectronicInvoiceRecord[]
  billingSequences          BillingSequence[]

  // Marketing leads that were converted into this tenant organization.
  marketingLeadsConverted   MarketingLead[]            @relation("MarketingLeadConvertedTo")

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

