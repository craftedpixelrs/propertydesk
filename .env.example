# =============================================================================
# PropertyDesk — example environment variables
# =============================================================================
# Copy to `.env` (or `.env.local`) and fill in real values.
# Never commit `.env`. Only `.env.example` (this file) is versioned.
# =============================================================================

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL in dev; portable to any Postgres in prod)
# ---------------------------------------------------------------------------
# Pooled (PgBouncer) connection string for the application runtime.
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/propertydesk?sslmode=require
# Direct (non-pooled) connection string for Prisma migrations.
DIRECT_URL=postgres://user:password@ep-example.eu-central-1.aws.neon.tech/propertydesk?sslmode=require

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# App identity
# ---------------------------------------------------------------------------
APP_NAME=PropertyDesk
APP_DOMAIN=propertydesk.app
APP_LOCALE=sr-Latn
APP_TIMEZONE=Europe/Belgrade

# Public (exposed to the browser). Must match the server values above.
NEXT_PUBLIC_APP_NAME=PropertyDesk
NEXT_PUBLIC_APP_DOMAIN=propertydesk.app
NEXT_PUBLIC_APP_LOCALE=sr-Latn
NEXT_PUBLIC_APP_TIMEZONE=Europe/Belgrade

# ---------------------------------------------------------------------------
# Marketing landing (propertydesk.app apex domain)
# ---------------------------------------------------------------------------
# URL of the authenticated app subdomain. All "sign in" / "open the app"
# CTAs on the marketing landing point at this value.
NEXT_PUBLIC_MY_APP_URL=https://my.propertydesk.app
# Loops (loops.so) — server-to-server transactional API key. Used by
# `POST /api/v1/marketing/leads` to upsert lead-capture submissions as
# Loops contacts. NEVER expose this to the browser.
LOOPS_API_KEY=
# Optional Loops "mailing list" ID; when set, every new lead is added to
# this list in addition to being tagged with their audience (Investors /
# Agencies) via the `userGroup` field.
LOOPS_MAILING_LIST_ID=
# Legacy public form ID for the previous embed integration. No longer
# used - kept only for backward compatibility.
NEXT_PUBLIC_LOOPS_FORM_ID=

# Google Calendar Appointment Schedules embed URL. When set, the demo
# booking iframe on `/demo` and the DemoTraining section renders inline.
# When empty, both surfaces fall back to a lead-form CTA.
# Copy the "Book with me" link from calendar.google.com Appointment
# Schedules -> Share -> "Copy embed" (schedules URL, NOT the raw share URL).
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=https://calendar.app.google/MvRGU5Kajmpawhnd6

# Public URL of the 90-180s product overview video. Two modes are
# auto-detected: YouTube (youtube.com / youtu.be) or MP4 file. Leave
# empty to render a click-to-book placeholder in the ProductVideo
# section.
NEXT_PUBLIC_PRODUCT_VIDEO_URL=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Options: console (dev), smtp, resend
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=PropertyDesk
EMAIL_FROM_ADDRESS=noreply@propertydesk.app

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Resend (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# Options: local (dev), s3 (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, ...)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=
# Local storage root directory (relative to project root when provider=local).
STORAGE_LOCAL_DIR=./storage

# ---------------------------------------------------------------------------
# Scheduled jobs & impersonation
# ---------------------------------------------------------------------------
# Shared secret required by /api/v1/jobs/* endpoints.
# Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string
# Extra secret used to sign impersonation events in the audit trail.
# Generate with: openssl rand -base64 32
IMPERSONATION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Development seed
# ---------------------------------------------------------------------------
# The `pnpm db:seed` script creates a SUPER_ADMIN account using these values.
# Change them for non-throwaway environments.
SEED_SUPER_ADMIN_EMAIL=admin@propertydesk.test
SEED_SUPER_ADMIN_PASSWORD=PropertyDesk!2026

# ---------------------------------------------------------------------------
# Feature toggles
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
