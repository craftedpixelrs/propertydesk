# PropertyDesk reverse proxy — Caddy v2.
#
#   propertydesk.app      → marketing (prod container)
#   my.propertydesk.app   → real product (prod container, new empty DB)
#   demo.propertydesk.app → client demo (app-demo, seeded DB)
#   staging.propertydesk.app → internal preview (app-staging; 502 if down)
#
# Each app host is a separate Next.js container + .env + database.
# See docs/environments.md.
#
# TLS: automatic via Let's Encrypt HTTP-01. For Cloudflare-proxied hosts
# (propertydesk.app) the DNS record must be in "DNS only" (grey cloud) at
# least during first issuance, or you must switch to DNS-01 challenge with
# a Cloudflare API token (not configured here).
#
# CADDY_EMAIL is read from the container env; if unset Caddy uses an
# anonymous ACME account (which still works but has no expiry notices).

{
	email {$CADDY_EMAIL:podrska@propertydesk.app}
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

propertydesk.app, www.propertydesk.app {
	encode zstd gzip

	# Strip `www.` — canonical is the apex.
	@www host www.propertydesk.app
	redir @www https://propertydesk.app{uri} permanent

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
		format console
	}
}

my.propertydesk.app {
	encode zstd gzip

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	log {
		output stdout
		format console
	}
}

