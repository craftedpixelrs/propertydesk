# Loops.so — server-to-server API key for the marketing lead-capture
# endpoint. Fill this in on the VPS `/opt/propertydesk/.env` file, then
# `docker compose restart app`. Never commit the real value.
LOOPS_API_KEY=
LOOPS_MAILING_LIST_ID=
# Legacy public form ID — no longer used (kept for backward compat).
NEXT_PUBLIC_LOOPS_FORM_ID=

# ---------------------------------------------------------------------------
# Email — Google Workspace keeps hello@ (MX). App sends via Resend as
# noreply@ (no extra Workspace seat). Recreate the app container after change.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=PropertyDesk
EMAIL_FROM_ADDRESS=noreply@propertydesk.app
EMAIL_REPLY_TO=hello@propertydesk.app

# SMTP (uncomment + fill when switching EMAIL_PROVIDER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# Resend (uncomment + fill when switching EMAIL_PROVIDER=resend)
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Storage — local files inside the container volume (mounted at /app/storage)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/app/storage

