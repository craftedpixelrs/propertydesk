# =============================================================================
# PropertyDesk app environment (copy per host — never commit the filled file)
#
#   Production (my. + apex):   /opt/propertydesk/.env
#   Demo:                      /opt/propertydesk/.env.demo
#   Staging:                   /opt/propertydesk/.env.staging
#
# Fill DATABASE_URL / DIRECT_URL from the Supabase project for THAT host.
# Each host needs its own BETTER_AUTH_SECRET (or at least its own URL).
# See docs/environments.md and docs/email.md.
# =============================================================================

NODE_ENV=production

# Supabase → Settings → Database
# DATABASE_URL  = Transaction pooler (port 6543)
# DIRECT_URL    = Session / direct (port 5432)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Must match the public hostname of THIS container:
#   prod    https://my.propertydesk.app
#   demo    https://demo.propertydesk.app
#   staging https://staging.propertydesk.app
BETTER_AUTH_URL=https://my.propertydesk.app
NEXT_PUBLIC_APP_URL=https://my.propertydesk.app

APP_NAME=PropertyDesk
APP_DOMAIN=propertydesk.app
APP_LOCALE=sr-Latn
APP_TIMEZONE=Europe/Belgrade

NEXT_PUBLIC_APP_NAME=PropertyDesk
NEXT_PUBLIC_APP_DOMAIN=propertydesk.app
NEXT_PUBLIC_APP_LOCALE=sr-Latn
NEXT_PUBLIC_APP_TIMEZONE=Europe/Belgrade
NEXT_PUBLIC_MY_APP_URL=https://my.propertydesk.app

EMAIL_PROVIDER=console
EMAIL_FROM_NAME=PropertyDesk
EMAIL_FROM_ADDRESS=noreply@propertydesk.app
EMAIL_REPLY_TO=hello@propertydesk.app
RESEND_API_KEY=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/app/storage

CRON_SECRET=replace-with-openssl-rand-base64-32
IMPERSONATION_SECRET=replace-with-openssl-rand-base64-32

# Production (my.): your real mailbox. Demo may keep the .test default.
SEED_SUPER_ADMIN_EMAIL=admin@propertydesk.test
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-long-password

RATE_LIMIT_ENABLED=true
CADDY_EMAIL=hello@propertydesk.app
